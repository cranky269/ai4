<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.6">
  <model name="ai4_planar_lidar">
    <static>true</static>
    <link name="lidar_link">
      <visual name="housing"><pose>0 0 -0.06 0 0 0</pose><geometry><cylinder><radius>0.06</radius><length>0.1</length></cylinder></geometry><material><ambient>0.2 0.3 0.4 1</ambient><diffuse>0.2 0.3 0.4 1</diffuse></material></visual>
      <sensor name="planar_ray" type="ray">
        <always_on>true</always_on><update_rate>10</update_rate><visualize>true</visualize>
        <ray>
          <scan><horizontal><samples>181</samples><resolution>1</resolution><min_angle>-0.7853981633974483</min_angle><max_angle>0.7853981633974483</max_angle></horizontal>
            <vertical><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></vertical></scan>
          <range><min>0.1</min><max>10</max><resolution>0.001</resolution></range>
          <noise><mean>0</mean><stddev>0</stddev><type>gaussian</type></noise>
        </ray>
        <plugin name="planar_ray_ros" filename="libgazebo_ros_laser.so"><robotNamespace>/lidar</robotNamespace><topicName>scan</topicName><frameName>lidar_link</frameName></plugin>
      </sensor>
    <visual name="fixed_platform"><pose>0 0 -0.55 0 0 0</pose><geometry><box><size>0.2 0.2 0.9</size></box></geometry></visual></link>
  </model>
</sdf>