catkin_ws/src/CMakeLists.txt

# ---- Python / Jupyter 缓存 ----
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.jupyter/

# ---- 测试产物 ----
.pytest_cache/
test/**/logs/

# ---- 其它运行时产物 ----
nohup.out
*.bag

# ----冲突库----
/lib/

# ---- 其他辅助文件（旧设计文档）----
design_old/    

# ---- 本地 MCP / 工具配置（不入库）----
.mcp.json
mcp_filters/
mcp使用注意事项/

